extends ./layouts/_dashboard_layout.pug

block append variables
	- var page_name = "dashboard";

block content
	// Dashboard Headline
	.dashboard-headline
		h3 Howdy, Tom!
		span We are glad to see you again!
		// Breadcrumbs
		nav#breadcrumbs.dark
			ul
				li
					a(href='#') Home
				li Dashboard
	// Fun Facts Container
	.fun-facts-container
		.fun-fact(data-fun-fact-color='#36bd78')
			.fun-fact-text
				span Task Bids Won
				h4 22
			.fun-fact-icon
				i.icon-material-outline-gavel
		.fun-fact(data-fun-fact-color='#b81b7f')
			.fun-fact-text
				span Jobs Applied
				h4 4
			.fun-fact-icon
				i.icon-material-outline-business-center
		.fun-fact(data-fun-fact-color='#efa80f')
			.fun-fact-text
				span Reviews
				h4 28
			.fun-fact-icon
				i.icon-material-outline-rate-review
		// Last one has to be hidden below 1600px, sorry :(
		.fun-fact(data-fun-fact-color='#2a41e6')
			.fun-fact-text
				span This Month Views
				h4 987
			.fun-fact-icon
				i.icon-feather-trending-up
	// Row
	.row
		.col-xl-8
			// Dashboard Box
			.dashboard-box.main-box-in-row
				.headline
					h3
						i.icon-feather-bar-chart-2
						|  Your Profile Views
					.sort-by
						select.selectpicker.hide-tick
							option Last 6 Months
							option This Year
							option This Month
				.content
					// Chart
					.chart
						canvas#chart(width='100', height='45')
			// Dashboard Box / End
		.col-xl-4
			// Dashboard Box
			//
				If you want adjust height of two boxes
				add to the lower box 'main-box-in-row'
				and 'child-box-in-row' to the higher box
			.dashboard-box.child-box-in-row
				.headline
					h3
						i.icon-material-outline-note-add
						|  Notes
				.content.with-padding
					// Note
					.dashboard-note
						p Meeting with candidate at 3pm who applied for Bilingual Event Support Specialist
						.note-footer
							span.note-priority.high High Priority
							.note-buttons
								a(href='#', title='Edit', data-tippy-placement='top')
									i.icon-feather-edit
								a(href='#', title='Remove', data-tippy-placement='top')
									i.icon-feather-trash-2
					// Note
					.dashboard-note
						p Extend premium plan for next month
						.note-footer
							span.note-priority.low Low Priority
							.note-buttons
								a(href='#', title='Edit', data-tippy-placement='top')
									i.icon-feather-edit
								a(href='#', title='Remove', data-tippy-placement='top')
									i.icon-feather-trash-2
					// Note
					.dashboard-note
						p Send payment to David Peterson
						.note-footer
							span.note-priority.medium Medium Priority
							.note-buttons
								a(href='#', title='Edit', data-tippy-placement='top')
									i.icon-feather-edit
								a(href='#', title='Remove', data-tippy-placement='top')
									i.icon-feather-trash-2
				.add-note-button
					a.popup-with-zoom-anim.button.full-width.button-sliding-icon(href='#small-dialog')
						| Add Note
						i.icon-material-outline-arrow-right-alt
			// Dashboard Box / End
	// Row / End
	// Row
	.row
		// Dashboard Box
		.col-xl-6
			.dashboard-box
				.headline
					h3
						i.icon-material-baseline-notifications-none
						|  Notifications
					button.mark-as-read.ripple-effect-dark(data-tippy-placement='left', title='Mark all as read')
						i.icon-feather-check-square
				.content
					ul.dashboard-box-list
						li
							span.notification-icon
								i.icon-material-outline-group
							span.notification-text
								strong Michael Shannah
								|  applied for a job
								a(href='#') Full Stack Software Engineer
							// Buttons
							.buttons-to-right
								a.button.ripple-effect.ico(href='#', title='Mark as read', data-tippy-placement='left')
									i.icon-feather-check-square
						li
							span.notification-icon
								i.icon-material-outline-gavel
							span.notification-text
								strong Gilber Allanis
								|  placed a bid on your
								a(href='#') iOS App Development
								|  project
							// Buttons
							.buttons-to-right
								a.button.ripple-effect.ico(href='#', title='Mark as read', data-tippy-placement='left')
									i.icon-feather-check-square
						li
							span.notification-icon
								i.icon-material-outline-autorenew
							span.notification-text
								| Your job listing
								a(href='#') Full Stack Software Engineer
								|  is expiring
							// Buttons
							.buttons-to-right
								a.button.ripple-effect.ico(href='#', title='Mark as read', data-tippy-placement='left')
									i.icon-feather-check-square
						li
							span.notification-icon
								i.icon-material-outline-group
							span.notification-text
								strong Sindy Forrest
								|  applied for a job
								a(href='#') Full Stack Software Engineer
							// Buttons
							.buttons-to-right
								a.button.ripple-effect.ico(href='#', title='Mark as read', data-tippy-placement='left')
									i.icon-feather-check-square
						li
							span.notification-icon
								i.icon-material-outline-rate-review
							span.notification-text
								strong David Peterson
								|  left you a
								span.star-rating.no-stars(data-rating='5.0')
								|  rating after finishing
								a(href='#')
									| Logo
									| Design
								|  task
							// Buttons
							.buttons-to-right
								a.button.ripple-effect.ico(href='#', title='Mark as read', data-tippy-placement='left')
									i.icon-feather-check-square
		// Dashboard Box
		.col-xl-6
			.dashboard-box
				.headline
					h3
						i.icon-material-outline-assignment
						|  Orders
				.content
					ul.dashboard-box-list
						li
							.invoice-list-item
								strong Professional Plan
								ul
									li
										span.unpaid Unpaid
									li Order: #326
									li Date: 12/08/2018
							// Buttons
							.buttons-to-right
								a.button(href='pages-checkout-page.html') Finish Payment
						li
							.invoice-list-item
								strong Professional Plan
								ul
									li
										span.paid Paid
									li Order: #264
									li Date: 10/07/2018
							// Buttons
							.buttons-to-right
								a.button.gray(href='pages-invoice-template.html') View Invoice
						li
							.invoice-list-item
								strong Professional Plan
								ul
									li
										span.paid Paid
									li Order: #211
									li Date: 12/06/2018
							// Buttons
							.buttons-to-right
								a.button.gray(href='pages-invoice-template.html') View Invoice
						li
							.invoice-list-item
								strong Professional Plan
								ul
									li
										span.paid Paid
									li Order: #179
									li Date: 06/05/2018
							// Buttons
							.buttons-to-right
								a.button.gray(href='pages-invoice-template.html') View Invoice
	// Row / End

block append modals
	//
		Apply for a job popup
		==================================================
	#small-dialog.zoom-anim-dialog.mfp-hide.dialog-with-tabs
		// Tabs
		.sign-in-form
			ul.popup-tabs-nav
				li
					a(href='#tab') Add Note
			.popup-tabs-container
				// Tab
				#tab.popup-tab-content
					// Welcome Text
					.welcome-text
						h3 Do Not Forget &#x1F60E;
					// Form
					form#add-note(method='post')
						select.selectpicker.with-border.default.margin-bottom-20(data-size='7', title='Priority')
							option Low Priority
							option Medium Priority
							option High Priority
						textarea.with-border(name='textarea', cols='10', placeholder='Note')
					// Button
					button.button.full-width.button-sliding-icon.ripple-effect(type='submit', form='add-note')
						i.icon-material-outline-arrow-right-alt
	// Apply for a job popup / End
block append scripts

	// Snackbar // documentation: https://www.polonel.com/snackbar/
	script.
		// Snackbar for user status switcher
		$('#snackbar-user-status label').click(function () {
			Snackbar.show({
			text: 'Your status has been changed!',
			pos: 'bottom-center',
			showAction: false,
			actionText: "Dismiss",
			duration: 3000,
			textColor: '#fff',
			backgroundColor: '#383838'
			});
		});
	// Chart.js // documentation: http://www.chartjs.org/docs/latest/
	script(src='js/chart.min.js')
	script.
		Chart.defaults.global.defaultFontFamily = "Nunito";
		Chart.defaults.global.defaultFontColor = '#888';
		Chart.defaults.global.defaultFontSize = '14';
		var ctx = document.getElementById('chart').getContext('2d');
		var chart = new Chart(ctx, {
		type: 'line',
		// The data for our dataset
		data: {
			labels: ["January", "February", "March", "April", "May", "June"],
			// Information about the dataset
			datasets: [{
				label: "Views",
				backgroundColor: 'rgba(42,65,232,0.08)',
				borderColor: '#2a41e8',
				borderWidth: "3",
				data: [196, 132, 215, 362, 210, 252],
				pointRadius: 5,
				pointHoverRadius: 5,
				pointHitRadius: 10,
				pointBackgroundColor: "#fff",
				pointHoverBackgroundColor: "#fff",
				pointBorderWidth: "2",
			}]
		},
		// Configuration options
		options: {
		layout: {
		padding: 10,
		},
		legend: {
		display: false
		},
		title: {
		display: false
		},
		scales: {
		yAxes: [{
		scaleLabel: {
		display: false
		},
		gridLines: {
		borderDash: [6, 10],
		color: "#d8d8d8",
		lineWidth: 1,
		},
		}],
		xAxes: [{
		scaleLabel: {
		display: false
		},
		gridLines: {
		display: false
		},
		}],
		},
		tooltips: {
		backgroundColor: '#333',
		titleFontSize: 13,
		titleFontColor: '#fff',
		bodyFontColor: '#fff',
		bodyFontSize: 13,
		displayColors: false,
		xPadding: 10,
		yPadding: 10,
		intersect: false
		}
		},
		});