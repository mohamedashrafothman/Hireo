mixin attachment_box(data={attachment: {}, user: {}}, index=0)
	.attachment-box.ripple-effect
		span(data-tippy, data-tippy-placement='top', title=data.attachment.name)=data.attachment.base
		i
			|.
			=_.upperCase(data.attachment.extname)
			|  File
		if (data.user._id.toString() === user._id.toString())
			a.remove-attachment(href=`/dashboard/settings/${data.user._id}/delete-attachment/${data.attachment._id}`, data-tippy, data-tippy-placement='top', title='Remove')
			a.download-attachment(href=`/dashboard/settings/${data.user._id}/attachment/${data.attachment._id}/download`, data-tippy, data-tippy-placement='top', title='download')