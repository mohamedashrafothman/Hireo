extends ./layouts/_index_layout.pug

block append variables
	- var page_name = "home 3";

block content
	//
		Intro Banner
		==================================================
	.intro-banner.dark-overlay.big-padding
		// Transparent Header Spacer
		.transparent-header-spacer
		.container
			// Intro Headline
			.row
				.col-md-12
					.banner-headline-alt
						h3 Don't Just Dream, Do
						span Find the best jobs in the digital industry
			// Search Bar
			.row
				.col-md-12
					.intro-banner-search-form.margin-top-95
						// Search Field
						.intro-search-field.with-autocomplete
							label.field-title.ripple-effect(for='autocomplete-input') Where?
							.input-with-icon
								input#autocomplete-input(type='text', placeholder='Online Job')
								i.icon-material-outline-location-on
						// Search Field
						.intro-search-field
							label.field-title.ripple-effect(for='intro-keywords') What job you want?
							input#intro-keywords(type='text', placeholder='Job Title or Keywords')
						// Button
						.intro-search-button
							button.button.ripple-effect(onclick="window.location.href='jobs-list-layout-1.html'") Search
			// Stats
			.row
				.col-md-12
					ul.intro-stats.margin-top-45.hide-under-992px
						li
							strong.counter 1,586
							span Jobs Posted
						li
							strong.counter 3,543
							span Tasks Posted
						li
							strong.counter 1,232
							span Freelancers
		// Video Container
		.video-container(data-background-image='images/home-video-background-poster.jpg')
			video(loop='', autoplay='', muted='')
				source(src='images/home-video-background.mp4', type='video/mp4')
