{
    "name": "hiero",
    "version": "0.1.0",
    "description": "Job posting & tasks marketplace.",
    "main": "index.js",
    "scripts": {
        "start": "npm run server:dev",
        "build": "babel ./src --out-dir dist && npm run assets:prod",
        "server:dev": "set NODE_ENV=development && npm-run-all clean && nodemon --exec babel-node ./src/index.js --ignore ./public/",
        "server:prod": "set NODE_ENV=production && npm-run-all clean build && node ./dist/index.js",
        "assets:dev": "cd public/ && npm run build:dev",
        "assets:prod": "cd public/ && npm run build:prod",
        "clean": "rimraf dist",
        "samples": "npm-run-all samples:drop samples:load",
        "samples:load": "babel-node ./src/utilities/Samples.js",
        "samples:drop": "babel-node ./src/utilities/Samples.js --drop"
    },
    "keywords": [],
    "author": "Mohamed Ashraf Othman",
    "license": "ISC",
    "dependencies": {
        "await-to-js": "^2.1.1",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.19.0",
        "chalk": "^4.1.0",
        "compression": "^1.7.4",
        "concat-stream": "^2.0.0",
        "connect-flash": "^0.1.1",
        "connect-mongo": "^3.2.0",
        "cookie-parser": "^1.4.5",
        "cron": "^1.8.2",
        "crypto": "^1.0.1",
        "csurf": "^1.11.0",
        "dotenv": "^8.2.0",
        "errorhandler": "^1.5.1",
        "express": "^4.17.1",
        "express-acl": "^2.0.8",
        "express-back": "0.0.2",
        "express-session": "^1.17.1",
        "express-useragent": "^1.0.15",
        "express-validator": "^6.6.0",
        "glob": "^7.1.6",
        "html-to-text": "^5.1.1",
        "i18n": "^0.10.0",
        "jimp": "^0.14.0",
        "juice": "^7.0.0",
        "lodash": "^4.17.19",
        "mkdirp": "^1.0.4",
        "moment": "^2.27.0",
        "mongo-morgan-ext": "^1.0.2",
        "mongoose": "^5.9.27",
        "mongoose-paginate-v2": "^1.3.9",
        "mongoose-slug-updater": "^3.2.3",
        "morgan": "^1.10.0",
        "multer": "^1.4.2",
        "nodemailer": "^6.4.11",
        "passport": "^0.4.1",
        "passport-facebook": "^3.0.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-http": "^0.3.0",
        "passport-local": "^1.0.0",
        "permission": "^1.1.0",
        "pug": "^3.0.0",
        "qs": "^6.9.4",
        "rimraf": "^3.0.2",
        "serve-favicon": "^2.5.0",
        "slug": "^3.3.4",
        "socket.io": "^2.3.0",
        "streamifier": "^0.1.1",
        "validator": "^13.1.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.10.5",
        "@babel/core": "^7.11.0",
        "@babel/node": "^7.10.5",
        "@babel/plugin-proposal-optional-chaining": "^7.11.0",
        "@babel/plugin-transform-runtime": "^7.11.0",
        "@babel/preset-env": "^7.11.0",
        "@babel/runtime": "^7.11.0",
        "babel-eslint": "^10.1.0",
        "babel-loader": "^8.1.0",
        "eslint": "^7.6.0",
        "eslint-config-airbnb-base": "^14.2.0",
