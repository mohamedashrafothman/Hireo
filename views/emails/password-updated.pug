extends ../layouts/_email_layout.pug
block content
	h2 Password Updated
		p Your credintial password has been changed
		p
			| Hello
			strong=` ${to.account.name}`
			=`, We wanted to let you know that your`
			strong=` ${sitename} `
			| password was reset.
		p Please do not reply to this email with your password, We will never ask for your password, and we strongly discourage you from sharing it with anyone.