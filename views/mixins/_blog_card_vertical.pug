mixin blog_card_vertical(data={}, index=0, reg=new RegExp("<\s*p[^>]*>(.*?)<\s*/\s*p>", "gi"))
	a.blog-compact-item-container(href=`/post/${data.slug}`)
		.blog-compact-item
			if (data.thumbnail && data.thumbnail.md)
				img(src=`/${data.thumbnail.md.path}`, alt=`${data.title}'s thumbnail`)
			span.blog-item-tag=data.category.name.en
			.blog-compact-item-content
				ul.blog-post-tags
					li=moment(data.created_at).format("LL")
				h3=data.title
				p
					|!{htmlToText.fromString(data.content.match(reg).join("").split(".").slice(0, 2).join("."), { ignoreHref: true })}
					if (data.content.match(reg).join("").split(".").length >= 2)
						| ...
