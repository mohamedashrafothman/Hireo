extends ../layouts/_index_layout.pug
include ../mixins/_breadcrumb.pug

block content

	//
		Titlebar
		==================================================
	#titlebar.gradient
		.container
			.row
				.col-md-12
					h2= `${_.capitalize(page_title)}`
					// Breadcrumbs
					+breadcrumb([urlSegment[0], urlSegment[2]])
	//
		Page Content
		==================================================
	.container
		.row
			.col-xl-6.offset-xl-3
				.login-register-page
					// Welcome Text
					.welcome-text
						h3 Let's reset your forgotten password!
					// Form
					form#reset-password-form(action=`${urlSegment.join('/')}` method='post')
						include ../partials/_csrf.pug
						.input-with-icon-left.input-with-icon-right
							i.icon-material-outline-lock.icon-left
							input#password.input-text.with-border(name='password', type='password', placeholder='Password', value=`${(data && data.old["password"]) ? data.old["password"] : ''}`, required='')
							i.icon-feather-eye.icon-right.show-password(data-target="#password")
						.input-with-icon-left.input-with-icon-right
							i.icon-material-outline-lock.icon-left
							input#password-repeat.input-text.with-border(name='confirmPassword', type='password', placeholder='Repeat Password', value=`${(data && data.old["confirmPassword"]) ? data.old["confirmPassword"] : ''}` required="")
							i.icon-feather-eye.icon-right.show-password(data-target="#password-repeat")
					// Button
					button.button.full-width.button-sliding-icon.ripple-effect.margin-bottom-10.margin-top-10(type='submit', form='reset-password-form')
						| Reset Password
						i.icon-material-outline-arrow-right-alt
	// Spacer
	.margin-top-70
	// Spacer / End


block append scripts