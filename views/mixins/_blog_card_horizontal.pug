mixin blog_card_horizontal(data={}, index=0)
	a.blog-post(href=`/post/${data.slug}`)
		// Blog Post Thumbnail
		.blog-post-thumbnail
			.blog-post-thumbnail-inner
				span.blog-item-tag=data.category.name.en
				if (data.thumbnail && data.thumbnail.md)
					img(src=`/${data.thumbnail.md.path}`, alt='')
		// Blog Post Content
		.blog-post-content
			span.blog-post-date=moment(data.created_at).format('LL')
			h3=data.title
			- var reg = new RegExp("<\s*p[^>]*>(.*?)<\s*/\s*p>", "gi");
			if (data.content.match(reg))
				p
					|!{htmlToText.fromString(data.content.match(reg).split("").slice(0, 300).join(""), { ignoreHref: true })}
					if (data.content.match(reg).join("").split("").length >= 300)
						| ...
			else
				p
					| !{htmlToText.fromString(data.content.split("").slice(0, 300).join(""), { ignoreHref: true })}
					if (data.content.split("").length >= 300)
						| ...
		// Icon
		.entry-icon
