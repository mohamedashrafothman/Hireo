extends ../layouts/_index_layout.pug
include ../mixins/_breadcrumb.pug

block content

	//
		Titlebar
		==================================================
	#titlebar.gradient
		.container
			.row
				.col-md-12
					h2= `${_.capitalize(page_title)}`
					// Breadcrumbs
					+breadcrumb([urlSegment[0], urlSegment[2]])
	//
		Page Content
		==================================================
	.container
		.row
			.col-xl-6.offset-xl-3
				.login-register-page
					// Welcome Text
					.welcome-text
						h3 We're glad to see you again!
						span
							| Don't have an account?
							a(href='/auth/register')  Sign Up!
					// Form
					form#login-form(action=`${urlSegment.join('/')}` method='post')
						include ../partials/_csrf.pug
						.input-with-icon-left
							i.icon-material-baseline-mail-outline.icon-left
							input#emailaddress.input-text.with-border(name='email', type='email', placeholder='Email Address', value=`${(data && data.old["email"]) ? data.old["email"] : ''}`, required)
						.input-with-icon-left.input-with-icon-right(data-tippy, data-tippy-placement='bottom', title=`Should be at least ${process.env.MINIMUM_PASSWORD_LENGTH} characters long, lowercase character, uppercase character, a number, and a special character.`)
							i.icon-material-outline-lock.icon-left
							input#password.input-text.with-border(name='password', type='password', placeholder='Password', value=`${(data && data.old["password"]) ? data.old["password"] : ''}`, required)
							i.icon-feather-eye.icon-right.show-password(data-target="#password")
						.checkbox
							input#remember(type='checkbox', name="remember",  checked=(data && _.isEqual(data.old["remember"], "on")) ? 'checked' : undefined)
							label(for='remember')
								span.checkbox-icon
								| Remember Me
					// Button
					button.button.full-width.button-sliding-icon.ripple-effect.margin-bottom-10.margin-top-10(type='submit', form='login-form', style="width:100%;")
						| Log In
						i.icon-material-outline-arrow-right-alt
					a.forgot-password(href='/auth/forgot') Forgot Password?
					// Social Login
					.social-login-separator.margin-top-15
						span or
					.social-login-buttons
						a.facebook-login.ripple-effect(href="/auth/facebook")
							i.icon-brand-facebook-f
							|  Log In via Facebook
						a.google-login.ripple-effect(href="/auth/google")
							i.icon-brand-google-plus-g
							|  Log In via Google+
	// Spacer
	.margin-top-70
	// Spacer / End


block append scripts