extends ../../layouts/_dashboard_layout.pug
include ../../mixins/_breadcrumb.pug
include ../../mixins/_pagination.pug


block content
	// Dashboard Headline
	.dashboard-headline
		h3=page_title
		// Breadcrumbs
		+breadcrumb(urlSegment)
	// Row
	.row
		// Dashboard Box
		if (data.categories.length)
			.col-md-6
				each category, index_1 in data.categories
					if ((index_1%2) != 1)
						.accordion.js-accordion.margin-top-20.margin-bottom-20
							// Accordion Item
							.accordion__item.js-accordion-item
								.accordion-header.js-accordion-header
									.accordion-header__name
										if category.icon
											span(class=`icon-${category.icon.type}-${category.icon.name}`)
										a(href="#")=category.name.en
									//  Buttons
									.accordion-header__buttons
										a.button.ripple-effect.icon(href=`/dashboard/categories/edit/${category.slug}`, data-tippy-placement="top", data-tippy, title="Edit")
											i.icon-feather-edit
										a.button.ripple-effect.popup-with-zoom-anim.icon(href=`#small-dialog-${index_1+1}`, data-tippy-placement="top", data-tippy, title="Delete")
											i.icon-feather-trash-2
										a.button.ripple-effect.icon(href=`/browse/jobs?categories[]=${category._id}`, data-tippy-placement="top", data-tippy, title="Show")
											i.icon-feather-eye
								// Accordtion Body
								.accordion-body.js-accordion-body(style='display: none;')
									// Accordion Content
									.accordion-body__contents=category.description.en
									if (category.childs.length)
										each sub_category, index_2 in category.childs
											// Sub Accordion Container
											.accordion.js-accordion
												// Sub Accordion
												.accordion__item.js-accordion-item
													.accordion-header.js-accordion-header
														a(href="#")=sub_category.name.en
														//  Buttons
														.accordion-header__buttons
															a.button.ripple-effect.icon(href=`/dashboard/categories/edit/${sub_category.slug}`, data-tippy-placement="top", data-tippy, title="Edit")
																i.icon-feather-edit
															a.button.ripple-effect.popup-with-zoom-anim.icon(href=`#small-dialog-${index_1+1}-${index_2+1}`, data-tippy-placement="top", data-tippy, title="Delete")
																i.icon-feather-trash-2
															a.button.ripple-effect.icon(href=`/browse/jobs?categories[]=${sub_category._id}`, data-tippy-placement="top", data-tippy, title="Show")
																i.icon-feather-eye
													// Accordtion Body
													.accordion-body.js-accordion-body(style='display: none;')
														// Accordion Content
														.accordion-body__contents=sub_category.description.en
								// Accordion Body / End
							// Accordion Item / End
			.col-md-6
				each category, index_1 in data.categories
					if ((index_1%2) != 0)
						.accordion.js-accordion.margin-top-20.margin-bottom-20
							// Accordion Item
							.accordion__item.js-accordion-item
								.accordion-header.js-accordion-header
									.accordion-header__name
										if category.icon
											span(class=`icon-${category.icon.type}-${category.icon.name}`)
										a(href="#")=category.name.en
									//  Buttons
									.accordion-header__buttons
										a.button.ripple-effect.icon(href=`/dashboard/categories/edit/${category.slug}`, data-tippy-placement="top", data-tippy, title="Edit")
											i.icon-feather-edit
										a.button.ripple-effect.popup-with-zoom-anim.icon(href=`#small-dialog-${index_1+1}`, data-tippy-placement="top", data-tippy, title="Delete")
											i.icon-feather-trash-2
										a.button.ripple-effect.icon(href=`/browse/jobs?categories[]=${category._id}`, data-tippy-placement="top", data-tippy, title="Show")
											i.icon-feather-eye
								// Accordtion Body
								.accordion-body.js-accordion-body(style='display: none;')
									// Accordion Content
									.accordion-body__contents=category.description.en
									if (category.childs.length)
										each sub_category, index_2 in category.childs
											// Sub Accordion Container
											.accordion.js-accordion
												// Sub Accordion
												.accordion__item.js-accordion-item
													.accordion-header.js-accordion-header
														a(href="#")=sub_category.name.en
														//  Buttons
														.accordion-header__buttons
															a.button.ripple-effect.icon(href=`/dashboard/categories/edit/${sub_category.slug}`, data-tippy-placement="top", data-tippy, title="Edit")
																i.icon-feather-edit
															a.button.ripple-effect.popup-with-zoom-anim.icon(href=`#small-dialog-${index_1+1}-${index_2+1}`, data-tippy-placement="top", data-tippy, title="Delete")
																i.icon-feather-trash-2
															a.button.ripple-effect.icon(href=`/browse/jobs?categories[]=${sub_category._id}`, data-tippy-placement="top", data-tippy, title="Show")
																i.icon-feather-eye
													// Accordtion Body
													.accordion-body.js-accordion-body(style='display: none;')
														// Accordion Content
														.accordion-body__contents=sub_category.description.en
								// Accordion Body / End
							// Accordion Item / End

block append modals
	//
		Delete Skill Dialog
		==================================================
	each category, index_1 in data.categories
		.zoom-anim-dialog.dialog-with-tabs.mfp-hide(id=`small-dialog-${index_1+1}`)
			// Tabs
			.sign-in-form
				ul.popup-tabs-nav
					li
						a(href=`tab-${index_1+1}`)= `Delete ${category.name.en} Category`
				.popup-tabs-container
					// Tab
					.popup-tab-content(id=`tab-${index_1+1}`)
						// Welcome Text
						.welcome-text
							h3 Are You sure you want to delete this category with it's sub-categories entierly?
							p This action can't be undo.
						// Form
						form(id=`delete-category-form-${index_1+1}` method="GET" action=`/dashboard/categories/delete/${category._id}`)
							include ../../partials/_csrf.pug
						// Button
						button.button.red.margin-top-35.full-width.ripple-effect(type="submit" form=`delete-category-form-${index_1+1}`)
							| Delete Now!
		each sub_category, index_2 in category.childs
			.zoom-anim-dialog.dialog-with-tabs.mfp-hide(id=`small-dialog-${index_1+1}-${index_2+1}`)
				// Tabs
				.sign-in-form
					ul.popup-tabs-nav
						li
							a(href=`tab-${index_1+1}-${index_2+1}`)= `Delete ${sub_category.name.en} Category`
					.popup-tabs-container
						// Tab
						.popup-tab-content(id=`tab-${index_1+1}-${index_2+1}`)
							// Welcome Text
							.welcome-text
								h3 Are You sure you want to delete this category with it's sub-categories entierly?
								p This action can't be undo.
							// Form
							form(id=`delete-category-form-${index_1+1}-${index_2+1}` method="GET" action=`/dashboard/categories/delete/${sub_category._id}`)
								include ../../partials/_csrf.pug
							// Button
							button.button.red.margin-top-35.full-width.ripple-effect(type="submit" form=`delete-category-form-${index_1+1}-${index_2+1}`)
								| Delete Now!
	// Delete My Account Modal / End
block append scripts