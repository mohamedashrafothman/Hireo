mixin blog_card_horizontal_sm(data={}, index=0)
	// .active
	a(href=`/post/${data.slug}`, class=`widget-content ${(index < 1) ? "active" : ""}`)
		if (data.thumbnail && data.thumbnail.md)
			img(src=`/${data.thumbnail.md.path}`, alt='')
		.widget-text
			h5=data.title
			span=moment(data.created_at).format("LL")
