	//
		Intro Banner
		==================================================
	.intro-banner.dark-overlay.big-padding
		// Transparent Header Spacer
		.transparent-header-spacer
		.container
			// Intro Headline
			.row
				.col-md-12
					.banner-headline-alt
						h3 Don't Just Dream, Do!
						span Find the best jobs in the digital industry
			// Search Bar
			.row
				.col-md-12
					form#search-jobs-form.intro-banner-search-form.margin-top-95(method="GET", action="/browse/jobs")
						// Search Field
						.intro-search-field.with-autocomplete
							label.field-title.ripple-effect(for='autocomplete-input') Where?
							.input-with-icon
								input#job-location-address.autocomplete-input(name="address", type='text', placeholder='Type Address')
								input#job-location-long.autocomplete-input-long(name="long", type="hidden")
								input#job-location-lat.autocomplete-input-lat(name="lat", type="hidden")
								i.icon-material-outline-location-on
						// Search Field
						.intro-search-field
							label.field-title.ripple-effect(for='intro-keywords') What you need done?
							input#intro-keywords(name="keywords[]", type='text', placeholder='e.g. build me a website')
						// Search Field
						.intro-search-field
							select.selectpicker.default(name="categories[]", data-selected-text-format='count', data-size='7', title='All Categories', data-live-search='true', multiple)
								each category, i in categories
									optgroup(label=category.name.en, data-icon=`icon-${category.icon.type}-${category.icon.name}`)
										each child, i in category.children
											option(value=child._id)=child.name.en

						// Button
						.intro-search-button
							button.button.ripple-effect(type="submit", form="search-jobs-form") Search
			// Stats
			.row
				.col-md-12
					ul.intro-stats.margin-top-45.hide-under-992px
						li
							strong.counter 1,586
							span Jobs Posted
						li
							strong.counter 3,543
							span Tasks Posted
						li
							strong.counter 1,232
							span Freelancers
		// Video Container
		.video-container(data-background-image='images/home-video-background-poster.jpg')
			video(loop autoplay muted)
				source(src='videos/home-video-background.mp4', type='video/mp4')

