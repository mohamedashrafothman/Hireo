extends ../../layouts/_dashboard_layout.pug
include ../../mixins/_breadcrumb.pug
include ../../mixins/_pagination.pug


block content
	// Dashboard Headline
	.dashboard-headline
		h3=page_title
		// Breadcrumbs
		+breadcrumb(urlSegment)
	// Row
	.row
		// Dashboard Box
		.col-md-12
			.dashboard-box.margin-top-0
				// Headline
				.headline
					.container.padding-right-0.padding-left-0
						.row.margin-right-0.margin-left-0(style="width: 100%")
							.col-5.padding-left-0
								h3
									i.icon-material-outline-school
									| Skills List
							.col-3
								.sort-by
									span Sort By:
									select.selectpicker.hide-tick(data-selected-text-format='count', data-size='4',onchange="this.options[this.selectedIndex].value && (window.location = this.options[this.selectedIndex].value)")
										- var query_option_1 = query;
										option(selected=(query.sort && query.sort.created_at === "desc") ? "selected" : undefined, value=`?${qs.stringify(_.merge(_.omit(query_option_1, "sort[created_at]"), { "sort[created_at]": "desc" }))}`) Newest
										- var query_option_2 = query;
										option(selected=(query.sort && query.sort.created_at === "asc") ? "selected" : undefined, value=`?${qs.stringify(_.merge(_.omit(query_option_1, "sort[created_at]"), { "sort[created_at]": "asc" }))}`) Oldest
							.col-4.padding-right-0
								.search-input
									.input-flat-with-icon-left
										form#search-input-form(action="", method="GET")
											input.input-text.autocomplete(name='q', type='text', placeholder='Search', value=query.q)
											button.autocomplete-button.ripple-effect(type="submit", form="search-input-form")
												i.icon-material-outline-search.icon-right
				.content
					ul.dashboard-box-list
						if data.skills.length
							each skill, i in data.skills
								li
									//  Skills Listing
									.skills-listing
										//  Skills Listing Details
										.skills-listing-details
											//  Details
											.skills-listing-description
												h3.skills-listing-title
													=(lang === "en") ? skill.name.en : skill.name.ar
												//  Skills Listing Footer
												.skills-listing-footer
													ul
														li
															i.icon-material-outline-date-range
															= `Posted on ${moment(skill.created_at).format('ll')}`
														if (moment(skill.updated_at).format('ll') != moment(skill.created_at).format('ll'))
															li
																i.icon-material-outline-date-range
																= `Updated at ${moment(skill.updated_at).format('ll')}`
														if (skill.users.length)
															li
																i.icon-feather-users
																= ` ${skill.users.length} ${(skill.users.length >= 2) ? "users" : "user"} attached`
												p.skills-description(style="display:none;")=skill.description.en
									//  Buttons
									.buttons-to-right.always-visible
										a.button.ripple-effect(href=`/dashboard/skills/edit/${skill.slug}`)
											i.icon-feather-edit
											| Edit
										a.button.red.ripple-effect.popup-with-zoom-anim(href=`#small-dialog-${i+1}`)
											i.icon-feather-trash-2
											| Remove
						else
							li(style="text-align:center;")
								//  Skills Listing
								.skills-listing
									//  Skills Listing Details
									.skills-listing-details
										//  Details
										.skills-listing-description
											h3.skills-listing-title No Skills Found
								//  Buttons
								.buttons-to-right.always-visible
									a.button.ripple-effect(href=`/dashboard/skills/add`)
										i.icon-feather-plus
										| Add First Skill
		if (hasNextPage || hasPrevPage)
			.col-md-12
				.pagination-container.margin-top-20.margin-bottom-20
					+pagination("/dashboard/skills/list", page, pages, query)

block append modals
	//
		Delete Skill Dialog
		==================================================
	each skill, i in data.skills
		.zoom-anim-dialog.dialog-with-tabs.mfp-hide(id=`small-dialog-${i+1}`)
			// Tabs
			.sign-in-form
				ul.popup-tabs-nav
					li
						a(href="#tab")= `Delete ${skill.name.en} Skill`
				.popup-tabs-container
					// Tab
					#tab.popup-tab-content
						// Welcome Text
						.welcome-text
							h3 Are You make sure you want to delete this skill entierly?
						// Form
						form(id=`delete-skill-form-${i+1}` method="GET" action=`/dashboard/skills/delete/${skill._id}`)
							include ../../partials/_csrf.pug
						// Button
						button.button.red.margin-top-35.full-width.ripple-effect(type="submit" form=`delete-skill-form-${i+1}`)
							| Delete Now!
	// Delete My Account Modal / End
block append scripts
	if (query.q)
		script.
			$(document).ready(function() {
				$(".skills-description, .skills-listing-title").each(function(index, ele) {
					$(ele).mark("#{query.q}", {element: "mark"}).filter(function(node, term, totalCounter, counter) {
						if ($(term).find("mark").length) {
							$(term).css({"display": "inline-block"});
						}
					});
				});
			});