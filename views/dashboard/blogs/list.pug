extends ../../layouts/_dashboard_layout.pug
include ../../mixins/_breadcrumb.pug
include ../../mixins/_pagination.pug

block content
	// Dashboard Headline
	.dashboard-headline
		h3=page_title
		// Breadcrumbs
		+breadcrumb(urlSegment)
	// Row
	.row
		// Dashboard Box
		.col-xl-12
			.dashboard-box.margin-top-0
				// Headline
				.headline
					.container.padding-right-0.padding-left-0
						.row.margin-right-0.margin-left-0(style="width: 100%")
							.col-5.padding-left-0
								h3
									i.icon-line-awesome-newspaper-o
									|  My Blog Posts List
							.col-3
								.sort-by
									span Sort By:
									select.selectpicker.hide-tick(data-selected-text-format='count', data-size='4',onchange="this.options[this.selectedIndex].value && (window.location = this.options[this.selectedIndex].value)")
										- var query_option_1 = query;
										option(selected=(query.sort && query.sort.created_at === "desc") ? "selected" : undefined, value=`?${qs.stringify(_.merge(_.omit(query_option_1, "sort[created_at]"), { "sort[created_at]": "desc" }))}`) Newest
										- var query_option_2 = query;
										option(selected=(query.sort && query.sort.created_at === "asc") ? "selected" : undefined, value=`?${qs.stringify(_.merge(_.omit(query_option_1, "sort[created_at]"), { "sort[created_at]": "asc" }))}`) Oldest
							.col-4.padding-right-0
								.search-input
									.input-flat-with-icon-left
										form#search-input-form(action="", method="GET")
											input.input-text.autocomplete(name='q', type='text', placeholder='Search', value=query.q)
											button.autocomplete-button.ripple-effect(type="submit", form="search-input-form")
												i.icon-material-outline-search.icon-right
				.content
					ul.dashboard-box-list
						if (!data.posts.length)
							li(style=`text-align:center;`)
								// Overview
								.job-listing.padding-top-15.padding-bottom-15(style="justify-content:center;")
									h4 No Posts added Yet
								//  Buttons
								.buttons-to-right.always-visible
									a.button.ripple-effect(href=`/dashboard/posts/add`)
										i.icon-feather-plus.margin-right-10
										| Add New Post
						else
							each post, i in data.posts
								li
									// Job Listing
									.job-listing
										// Job Listing Details
										.job-listing-details
											if _.isEqual(user.role, "admin")
												// Logo
												a.job-listing-company-logo(href=`/post/${post.slug}`)
													if (post.created_by.account.picture || post.created_by.account.picture_md)
														img(src=(!post.created_by.account.picture) ? `/${post.created_by.account.picture_md.path}` : `/${post.created_by.account.picture.path}`, alt='')
													else
														img(src=`${post.created_by.gravatar(50)}`)
											// Details
											.job-listing-description
												h3.job-listing-title
													a(href=`/job/${post.slug}`)=post.title
													case post.status
														when 1
															span.dashboard-status-button.margin-bottom-0.green Published
														when 2
															span.dashboard-status-button.margin-bottom-0.gray Drafted
														default
															- break
												div.job-listing-description.margin-top-0(style="display:none;")
													| !{post.content}
												// Job Listing Footer
												.job-listing-footer
													ul
														li
															i.icon-material-outline-date-range
															= `Published on ${moment(post.created_at).format('ll')}`
														li
															i.icon-material-outline-date-range
															= `Updated on ${moment(post.updated_at).format('ll')}`
									// Buttons
									.buttons-to-right
										a.button.gray.ripple-effect.ico(href=`/dashboard/posts/edit/${post.slug}`, title='Edit', data-tippy, data-tippy-placement='top')
											i.icon-feather-edit
										if (_.isEqual(post.created_by._id.toString(), user._id.toString()) || _.isEqual(user.role, "admin"))
											a.button.red.ripple-effect.popup-with-zoom-anim.ico(href=`#small-dialog-${i+1}`, title='Remove', data-tippy, data-tippy-placement='top')
												i.icon-feather-trash-2
	// Row / End
	if (hasNextPage || hasPrevPage)
		.col-md-12
			.pagination-container.margin-top-20.margin-bottom-20
				+pagination("/dashboard/posts/list", page, pages, query)
			// Pagination / End
	// Row / End

block append modals
	//
		Delete Skill Dialog
		==================================================
	each post, i in data.posts
		.zoom-anim-dialog.dialog-with-tabs.mfp-hide(id=`small-dialog-${i+1}`)
			// Tabs
			.sign-in-form
				ul.popup-tabs-nav
					li
						a(href="#tab")= `Delete ${post.title} Blog Post`
				.popup-tabs-container
					// Tab
					#tab.popup-tab-content
						// Welcome Text
						.welcome-text
							h3 Are You make sure you want to delete this Blog Post entirely?
						// Form
						form(id=`delete-post-form-${i+1}` method="GET" action=`/dashboard/posts/delete/${post._id}`)
							include ../../partials/_csrf.pug
						// Button
						button.button.red.margin-top-35.full-width.ripple-effect(type="submit" form=`delete-post-form-${i+1}`)
							| Delete Now!
	// Delete My Account Modal / End
block append scripts
