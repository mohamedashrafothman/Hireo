//
	Dashboard Sidebar
	==================================================
.dashboard-sidebar
	.dashboard-sidebar-inner(data-simplebar)
		.dashboard-nav-container
			// Responsive Navigation Trigger
			a.dashboard-responsive-nav-trigger(href='#')
				span.hamburger.hamburger--collapse
					span.hamburger-box
						span.hamburger-inner
				span.trigger-title Dashboard Navigation
			// Navigation
			.dashboard-nav
				.dashboard-nav-inner
					ul(data-submenu-title='Start')
						li#dashboard-nav-item(class=(_.lowerCase(page_title) === 'dashboard') ? "active" : "")
							a(href='/dashboard')
								i.icon-material-outline-dashboard
								|  Dashboard
						li#messages-nav-item(class=(_.lowerCase(page_title) === 'messages') ? "active" : "")
							a(href='/dashboard/conversations')
								i.icon-material-outline-question-answer
								|  Messages
								if (unReadMessages.filter(function(current) { return !Boolean(current.was_read); }).length)
									span.nav-tag=unReadMessages.filter(function(current) { return !Boolean(current.was_read); }).length
						li#bookmarks-nav-item(class=(_.lowerCase(page_title) === 'bookmarks') ? "active" : "")
							a(href='/dashboard/bookmarks')
								i.icon-material-outline-star-border
								|  Bookmarks
						li#reviews-nav-item
							a(href='dashboard-reviews.html')
								i.icon-material-outline-rate-review
								|  Reviews
					ul(data-submenu-title='Organize and Manage')
						if (user && !_.isEqual(user.role, "freelancer"))
							- var applications_pages_title = ["Manage All Posts", "Add New Post", "Edit a Post"];
							li#applications-nav-item(class=(applications_pages_title.includes(page_title)) ? "active-submenu" : "")
								a(href='#')
									i.icon-line-awesome-newspaper-o
									|  Blog Posts
								ul
									li#manage-all-posts-nav-item(class=(page_title === "Manage All Posts") ? "active" : "")
										a(href='/dashboard/posts/list')
											| Manage All Posts
									li#add-new-post-nav-item(class=(page_title === "Add New Post" || page_title === "Edit a Post") ? "active" : "")
										a(href='/dashboard/posts/add') Add New Post
						if (user && !_.isEqual(user.role, "employer"))
							- var applications_pages_title = ["Manage All Applications"];
							li#applications-nav-item(class=(applications_pages_title.includes(page_title)) ? "active-submenu" : "")
								a(href='#')
									i.icon-material-outline-assignment
									|  Applications
								ul
									li#manage-all-applications-nav-item(class=(page_title === "Manage All Applications") ? "active" : "")
										a(href='/dashboard/applications/list')
											| Manage All Applications
						if (user && !_.isEqual(user.role, "freelancer"))
							- var jobs_pages_title = ["Manage All Jobs", "Post a Job", "Edit a Job", "Manage Candidates"];
							li#jobs-nav-item(class=(jobs_pages_title.includes(page_title) || (user.role === "employer" && unSeenApplicationsCount >= 1)) ? "active-submenu" : "")
								a(href='#')
									i.icon-material-outline-business-center
									|  Jobs
								ul
									li#manage-jobs-nav-item(class=(page_title === "Manage All Jobs" || page_title === "Manage Candidates") ? "active" : "")
										a(href='/dashboard/jobs/list')
											| Manage Jobs
											if (unSeenApplicationsCount >= 1)
												span.nav-tag=unSeenApplicationsCount
									li#post-a-job-nav-item(class=(page_title === "Post a Job" || page_title === "Edit a Job") ? "active" : "")
										a(href='/dashboard/jobs/add') Post a Job
						if (user && _.isEqual(user.role, "admin"))
							- var categories_pages_title = ["Manage All Categories", "Edit a Category", "Add a Category"];
							li#categories-nav-item(class=(categories_pages_title.includes(page_title)) ? "active-submenu" : "")
								a(href='#')
									i.icon-material-outline-folder
									|  Categories
								ul
									li#manage-all-categories-nav-item(class=(page_title === "Manage All Categories" || page_title === "Edit a Category") ? "active" : "")
										a(href='/dashboard/categories/list')
											| Manage All Categories
									li#add-a-category-nav-item(class=(page_title === "Add a Category") ? "active" : "")
										a(href='/dashboard/categories/add') Add a Category
							- var skills_pages_title = ["Manage All Skills", "Edit a Skill", "Add a Skill"];
							li#skills-nav-items(class=(skills_pages_title.includes(page_title)) ? "active-submenu" : "")
								a(href='#')
									i.icon-material-outline-school
									|  Skills
								ul
									li#manage-all-skills-nav-item(class=(page_title === "Manage All Skills" || page_title === "Edit a Skill") ? "active" : "")
										a(href='/dashboard/skills/list')
											| Manage All Skills
									li#add-a-skills-nav-item(class=(page_title === "Add a Skill") ? "active" : "")
										a(href='/dashboard/skills/add') Add a Skill
							- var users_pages_title = ["Manage All Users"];
							li#users-nav-item(class=(users_pages_title.includes(page_title)) ? "active-submenu" : "")
								a(href='#')
									i.icon-feather-users
									|  Users
								ul
									li#manag-all-users-nav-item(class=(page_title === "Manage All Users") ? "active" : "")
										a(href="/dashboard/users/list")
											| Manage All Users
					ul(data-submenu-title='Account')
						li#settings-nav-item(class=(page_title === 'Settings') ? "active" : "")
							a(href='/dashboard/settings')
								i.icon-material-outline-settings
								|  Settings
						li#logout-nav-item
							a(href='/auth/logout')
								i.icon-material-outline-power-settings-new
								|  Logout
			// Navigation / End
// Dashboard Sidebar / End
