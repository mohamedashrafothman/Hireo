extends ../../layouts/_dashboard_layout.pug
include ../../mixins/_breadcrumb.pug
include ../../mixins/_categories_accordion.pug

block content
	// Dashboard Headline
	.dashboard-headline
		h3=page_title
		// Breadcrumbs
		+breadcrumb(urlSegment)
	// Row
	.row
		// Dashboard Box
		if (data.categories.length)
			.col-lg-6
				- var evenCategories = data.categories.filter((x, i) => (i%2 == 0));
				+categories_accordion(evenCategories)
			.col-lg-6
				- var oddCategories = data.categories.filter((x, i) => (i%2 != 0));
				+categories_accordion(oddCategories)
block append modals
block append scripts
